{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "mokda-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_LIMITER", "class_name": "ChatLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatLimiter"] }],
  "vars": {
    "CHAT_AI_ENABLED": "false",
    "ALLOW_LOCALHOST": "false",
    "DAILY_AI_LIMIT": "80"
  },
  "observability": { "enabled": false }
}
